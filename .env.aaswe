# AASWE Environment Configuration - context-only mode
# Uncomment and configure as needed

# Context-Only Mode Configuration
# No additional API keys required - uses your existing IDE LLM

# Neo4j Configuration (when running with Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aaswe-password
NEO4J_DATABASE=neo4j

# Logging
LOG_LEVEL=info