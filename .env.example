# AASWE Configuration Template
# Copy this file to .env and customize as needed

# =============================================================================
# API KEYS (Optional - for enhanced LLM features)
# =============================================================================
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the AASWE MCP server
PORT=3001

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Environment: development, production
NODE_ENV=development

# Enable CORS for web interface
ENABLE_CORS=true

# =============================================================================
# NEO4J CONFIGURATION (Full System Mode Only)
# =============================================================================
# Neo4j connection details
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aaswe-password

# Neo4j memory settings (for Docker)
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2g
NEO4J_PAGECACHE_SIZE=1g

# =============================================================================
# ANALYSIS CONFIGURATION
# =============================================================================
# Analysis depth: basic, detailed, comprehensive
ANALYSIS_DEPTH=comprehensive

# Preserve business context during re-analysis
PRESERVE_BUSINESS_CONTEXT=true

# Enable incremental analysis for better performance
ENABLE_INCREMENTAL_ANALYSIS=true

# Maximum files to analyze in one batch
MAX_ANALYSIS_BATCH_SIZE=100

# =============================================================================
# TTL GENERATION SETTINGS
# =============================================================================
# Output directory for TTL files
TTL_OUTPUT_DIRECTORY=./knowledge

# Include business context placeholders
INCLUDE_BUSINESS_CONTEXT=true

# Optimize TTL files for LLM consumption
OPTIMIZE_FOR_LLM=true

# Optimize TTL files for Neo4j import
OPTIMIZE_FOR_NEO4J=true

# =============================================================================
# FILE PATTERNS
# =============================================================================
# Files to include in analysis (comma-separated glob patterns)
INCLUDE_PATTERNS=**/*.ts,**/*.js,**/*.py,**/*.java,**/*.go,**/*.rs

# Files to exclude from analysis (comma-separated glob patterns)
EXCLUDE_PATTERNS=**/node_modules/**,**/dist/**,**/build/**,**/target/**,**/.git/**

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Enable file watching for real-time updates
ENABLE_FILE_WATCHING=true

# File watching debounce delay (ms)
FILE_WATCH_DEBOUNCE=1000

# Maximum memory usage for Node.js (MB)
MAX_MEMORY=2048

# Enable caching for better performance
ENABLE_CACHING=true

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Enable authentication (for production)
ENABLE_AUTH=false

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Enable metrics collection
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker network name
DOCKER_NETWORK=aaswe-network

# Docker volume prefix
DOCKER_VOLUME_PREFIX=aaswe

# Enable Docker health checks
DOCKER_HEALTH_CHECK=true